diff --git a/ggml/src/stigma-crypt.cpp b/ggml/src/stigma-crypt.cpp
new file mode 100644
index 0000000..a5db802
--- /dev/null
+++ b/ggml/src/stigma-crypt.cpp
@@ -0,0 +1,172 @@
+// stigma: at-rest model encryption for PROTOCOL: STIGMA
+//
+// AES-256-CTR over the whole .gguf, counter block = [file_size (be64) | block_index (be64)].
+// The file stays the same size, so every GGUF offset is unchanged and reads can be decrypted in place.
+// key = half compiled into this binary (stigma-key.inc, generated, never committed) XOR half sent by the game on stdin.
+// The plaintext never touches the disk: it only exists in the read buffer right before upload.
+
+#include "gguf.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+
+#if defined(_WIN32)
+#define WIN32_LEAN_AND_MEAN
+#ifndef NOMINMAX
+#    define NOMINMAX
+#endif
+#include <windows.h>
+#include <bcrypt.h>
+
+#include "stigma-key.inc" // defines stigma_bin_half(uint8_t out[32])
+
+namespace {
+
+struct stigma_state {
+    std::once_flag    once;
+    std::mutex        mtx;
+    bool              ok  = false;
+    BCRYPT_ALG_HANDLE alg = nullptr;
+    BCRYPT_KEY_HANDLE key = nullptr;
+};
+
+stigma_state & state() {
+    static stigma_state s;
+    return s;
+}
+
+int hexval(char c) {
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+// the game writes 64 hex chars to our stdin right after spawning us, then closes the pipe
+bool read_game_half(uint8_t out[32]) {
+    HANDLE h = GetStdHandle(STD_INPUT_HANDLE);
+    if (h == nullptr || h == INVALID_HANDLE_VALUE) {
+        return false;
+    }
+    char  buf[64];
+    DWORD got = 0;
+    while (got < sizeof(buf)) {
+        DWORD n = 0;
+        if (!ReadFile(h, buf + got, (DWORD) sizeof(buf) - got, &n, nullptr) || n == 0) {
+            return false;
+        }
+        got += n;
+    }
+    for (int i = 0; i < 32; i++) {
+        const int hi = hexval(buf[2*i]);
+        const int lo = hexval(buf[2*i + 1]);
+        if (hi < 0 || lo < 0) {
+            SecureZeroMemory(buf, sizeof(buf));
+            return false;
+        }
+        out[i] = (uint8_t) ((hi << 4) | lo);
+    }
+    SecureZeroMemory(buf, sizeof(buf));
+    return true;
+}
+
+void init() {
+    stigma_state & s = state();
+
+    uint8_t a[32];
+    uint8_t b[32];
+    if (!read_game_half(b)) {
+        return;
+    }
+    stigma_bin_half(a);
+    for (int i = 0; i < 32; i++) {
+        a[i] ^= b[i];
+    }
+    SecureZeroMemory(b, sizeof(b));
+
+    if (BCryptOpenAlgorithmProvider(&s.alg, BCRYPT_AES_ALGORITHM, nullptr, 0) == 0 &&
+        BCryptSetProperty(s.alg, BCRYPT_CHAINING_MODE, (PUCHAR) BCRYPT_CHAIN_MODE_ECB, sizeof(BCRYPT_CHAIN_MODE_ECB), 0) == 0 &&
+        BCryptGenerateSymmetricKey(s.alg, &s.key, nullptr, 0, a, sizeof(a), 0) == 0) {
+        s.ok = true;
+    }
+    SecureZeroMemory(a, sizeof(a));
+}
+
+bool ready() {
+    stigma_state & s = state();
+    std::call_once(s.once, init);
+    return s.ok;
+}
+
+void put_be64(uint8_t * p, uint64_t v) {
+    for (int i = 7; i >= 0; i--) {
+        p[i] = (uint8_t) (v & 0xff);
+        v >>= 8;
+    }
+}
+
+} // namespace
+
+bool gguf_stigma_is_encrypted(const uint8_t head[4], uint64_t file_size) {
+    if (memcmp(head, GGUF_MAGIC, 4) == 0) {
+        return false; // plain gguf (dev builds, other models)
+    }
+    if (!ready()) {
+        return false;
+    }
+    uint8_t probe[4];
+    memcpy(probe, head, 4);
+    gguf_stigma_xor(probe, 4, 0, file_size);
+    return memcmp(probe, GGUF_MAGIC, 4) == 0;
+}
+
+void gguf_stigma_xor(void * data, size_t len, uint64_t file_offset, uint64_t file_size) {
+    if (len == 0 || !ready()) {
+        return;
+    }
+    stigma_state & s = state();
+
+    constexpr size_t CHUNK_BLOCKS = 1u << 16; // 1 MiB of keystream per BCrypt call
+    static thread_local uint8_t ks[CHUNK_BLOCKS * 16];
+
+    uint8_t * p     = static_cast<uint8_t *>(data);
+    uint64_t  block = file_offset / 16;
+    size_t    skip  = (size_t) (file_offset % 16);
+
+    while (len > 0) {
+        const size_t need   = skip + len;
+        const size_t blocks = std::min<size_t>((need + 15) / 16, CHUNK_BLOCKS);
+        for (size_t i = 0; i < blocks; i++) {
+            put_be64(ks + i*16,     file_size);
+            put_be64(ks + i*16 + 8, block + i);
+        }
+        ULONG out = 0;
+        {
+            std::lock_guard<std::mutex> lock(s.mtx);
+            BCryptEncrypt(s.key, ks, (ULONG) (blocks*16), nullptr, nullptr, 0, ks, (ULONG) (blocks*16), &out, 0);
+        }
+        const size_t n = std::min(len, blocks*16 - skip);
+        const uint8_t * k = ks + skip;
+        for (size_t i = 0; i < n; i++) {
+            p[i] ^= k[i];
+        }
+        SecureZeroMemory(ks, blocks*16); // only what was used: header parsing does thousands of tiny reads
+        p     += n;
+        len   -= n;
+        block += blocks;
+        skip   = 0;
+    }
+}
+
+#else
+
+bool gguf_stigma_is_encrypted(const uint8_t *, uint64_t) {
+    return false;
+}
+
+void gguf_stigma_xor(void *, size_t, uint64_t, uint64_t) {
+}
+
+#endif
